                   coef = "Intercept") +
  prior(exponential(3), class = "sd", group = "patient", coef = "zAge") +
  prior(lkj(2), class = "cor", group = "patient")
fit5 <- brm(count ~ zAge * Trt +
              (1 + zAge * Trt | gr(patient, s2z = TRUE)),
            data = epilepsy, family = poisson(), prior = s2z_prior)
}

